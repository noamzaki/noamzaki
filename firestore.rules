rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Is this signed-in user the SHOP (not a customer portal login)?
    function isShop() {
      return request.auth != null
        && !request.auth.token.email.matches('.*@customers\\.wholesale-billing\\.app');
    }

    // Public shop card shown on the portal login screen
    match /portal_shop/{doc} {
      allow read: if true;
      allow write: if isShop();
    }

    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if isShop();
    }

    match /customers/{id} {
      allow read: if isShop()
        || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow write: if isShop();
    }

    match /invoices/{id} {
      allow read: if isShop()
        || (request.auth != null
            && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if isShop();
    }

    match /payments/{id} {
      allow read: if isShop()
        || (request.auth != null
            && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if isShop();
    }

    match /{col}/{id} {
      allow read, write: if isShop() && col in ['products', 'moves', 'staff'];
    }
  }
}
